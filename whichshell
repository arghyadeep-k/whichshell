#!/usr/bin/env python3
"""Report which shell is currently running, where it lives, and other details."""

import json
import os
import shutil
import subprocess
import sys

IS_WINDOWS = os.name == "nt"

if not IS_WINDOWS:
    import pwd

CONFIG_FILES = {
    "bash": ["~/.bashrc", "~/.bash_profile", "~/.profile"],
    "zsh": ["~/.zshrc", "~/.zprofile", "~/.zshenv"],
    "fish": ["~/.config/fish/config.fish"],
    "ksh": ["~/.kshrc", "~/.profile"],
    "csh": ["~/.cshrc", "~/.login"],
    "tcsh": ["~/.tcshrc", "~/.cshrc", "~/.login"],
    "dash": ["~/.profile"],
    "sh": ["~/.profile"],
}


# --- POSIX (Linux/macOS) detection ---------------------------------------

def read_proc_shell(pid):
    """Return (exe_path, argv) for pid via /proc, or (None, None)."""
    try:
        exe_path = os.readlink(f"/proc/{pid}/exe")
    except OSError:
        exe_path = None
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
        argv = [p.decode(errors="replace") for p in raw.split(b"\0") if p]
    except OSError:
        argv = None
    return exe_path, argv


def read_parent_pid(pid):
    """Return the PPID of the given pid, or None."""
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except (OSError, ValueError):
        pass
    try:
        out = subprocess.run(
            ["ps", "-o", "ppid=", "-p", str(pid)],
            capture_output=True, text=True, timeout=2,
        ).stdout.strip()
        return int(out) if out else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def read_ps_shell(pid):
    """Fallback for POSIX systems without /proc (e.g. macOS): use ps."""
    try:
        out = subprocess.run(
            ["ps", "-o", "comm=,args=", "-p", str(pid)],
            capture_output=True, text=True, timeout=2,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None, None
    if not out:
        return None, None
    comm, _, args = out.partition(" ")
    exe_path = shutil.which(comm) or comm
    argv = args.split() if args else [comm]
    return exe_path, argv


def get_version(path):
    try:
        result = subprocess.run(
            [path, "--version"], capture_output=True, text=True, timeout=2,
        )
        text = (result.stdout or result.stderr).strip()
        return text.splitlines()[0] if text else None
    except (OSError, subprocess.SubprocessError):
        return None


def find_config_files(shell_name):
    candidates = CONFIG_FILES.get(shell_name, ["~/.profile"])
    results = []
    for c in candidates:
        expanded = os.path.expanduser(c)
        results.append((c, os.path.isfile(expanded)))
    return results


def detect_posix_flags(argv):
    """Return (is_login, is_interactive) from a shell's argv.

    is_interactive is None when neither -i nor -c is present, meaning the
    caller should fall back to another signal (e.g. stdin.isatty())."""
    argv0 = argv[0] if argv else ""
    rest = argv[1:] if argv else []
    is_login = argv0.startswith("-") or "-l" in rest or "--login" in rest
    if any(a == "-i" or (a.startswith("-") and "i" in a and not a.startswith("--")) for a in rest):
        is_interactive = True
    elif "-c" in rest:
        is_interactive = False
    else:
        is_interactive = None
    return is_login, is_interactive


# --- Windows (cmd.exe / PowerShell) detection -----------------------------

def parse_win_cim_json(text):
    """Parse Get-CimInstance ConvertTo-Json output into (exe_path, argv, parent_pid).

    Returns (None, None, None) if text is empty or not valid JSON."""
    text = (text or "").strip()
    if not text:
        return None, None, None
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return None, None, None
    exe_path = data.get("ExecutablePath") or data.get("Name")
    cmdline = data.get("CommandLine") or ""
    argv = cmdline.split() if cmdline else [data.get("Name", "")]
    return exe_path, argv, data.get("ParentProcessId")


def detect_windows_interactive(shell_name, argv):
    """Return True/False/None (unknown) for whether the Windows shell is interactive."""
    rest = argv[1:] if argv else []
    name = shell_name.lower()
    if name in ("powershell.exe", "pwsh.exe"):
        return not any(a.lower() == "-noninteractive" for a in rest)
    if name == "cmd.exe":
        return not any(a.lower() == "/c" for a in rest)
    return None


def read_windows_process(pid):
    """Return (exe_path, argv, parent_pid) for pid via PowerShell CIM, or (None, None, None)."""
    ps_cmd = (
        f"$p = Get-CimInstance Win32_Process -Filter \"ProcessId={pid}\"; "
        "if ($p) { [PSCustomObject]@{ "
        "Name=$p.Name; ExecutablePath=$p.ExecutablePath; "
        "CommandLine=$p.CommandLine; ParentProcessId=$p.ParentProcessId "
        "} | ConvertTo-Json -Compress }"
    )
    for exe in ("powershell", "pwsh"):
        try:
            result = subprocess.run(
                [exe, "-NoProfile", "-NonInteractive", "-Command", ps_cmd],
                capture_output=True, text=True, timeout=5,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        exe_path, argv, parent_pid = parse_win_cim_json(result.stdout)
        if exe_path:
            return exe_path, argv, parent_pid
    return None, None, None


def get_version_windows(exe_path, shell_name):
    name = shell_name.lower()
    try:
        if name in ("powershell.exe", "pwsh.exe"):
            result = subprocess.run(
                [exe_path, "-NoProfile", "-NonInteractive", "-Command",
                 "$PSVersionTable.PSVersion.ToString()"],
                capture_output=True, text=True, timeout=5,
            )
            text = result.stdout.strip()
            return f"PowerShell {text}" if text else None
        if name == "cmd.exe":
            result = subprocess.run(["cmd", "/c", "ver"], capture_output=True, text=True, timeout=5)
            text = result.stdout.strip()
            return text.splitlines()[-1] if text else None
    except (OSError, subprocess.SubprocessError):
        return None
    return None


def read_cmd_autorun():
    try:
        import winreg
    except ImportError:
        return None
    try:
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Command Processor") as key:
            value, _ = winreg.QueryValueEx(key, "AutoRun")
            return value
    except OSError:
        return None


def find_config_files_windows(shell_name):
    name = shell_name.lower()
    home = os.path.expanduser("~")
    if name in ("powershell.exe", "pwsh.exe"):
        candidates = [
            os.path.join(home, "Documents", "WindowsPowerShell", "Microsoft.PowerShell_profile.ps1"),
            os.path.join(home, "Documents", "PowerShell", "Microsoft.PowerShell_profile.ps1"),
        ]
        return [(c, os.path.isfile(c)) for c in candidates]
    if name == "cmd.exe":
        autorun = read_cmd_autorun()
        label = r"HKCU\Software\Microsoft\Command Processor\AutoRun"
        return [(label, autorun is not None)]
    return []


# --- main -------------------------------------------------------------

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(f"Usage: {os.path.basename(sys.argv[0])}")
        print("Reports the shell you are currently running, its location, and other details.")
        return

    ppid = os.getppid()

    if IS_WINDOWS:
        exe_path, argv, shell_ppid = read_windows_process(ppid)
    else:
        exe_path, argv = read_proc_shell(ppid)
        if exe_path is None and argv is None:
            exe_path, argv = read_ps_shell(ppid)
        shell_ppid = read_parent_pid(ppid)

    if not exe_path:
        print("Could not determine the running shell.", file=sys.stderr)
        if IS_WINDOWS:
            print("(PowerShell or pwsh is required on the PATH to query process details.)",
                  file=sys.stderr)
        else:
            print("(no /proc and `ps` unavailable)", file=sys.stderr)
        sys.exit(1)

    shell_name = os.path.basename(exe_path)

    if IS_WINDOWS:
        version = get_version_windows(exe_path, shell_name)
        config_files = find_config_files_windows(shell_name)
        is_login = None  # not a meaningful concept on Windows
        is_interactive = detect_windows_interactive(shell_name, argv)
    else:
        version = get_version(exe_path)
        config_files = find_config_files(shell_name)
        is_login, is_interactive = detect_posix_flags(argv)
        if is_interactive is None:
            # No explicit -i/-c flag either way; fall back to whether our
            # own stdin (inherited from the shell) is a terminal.
            is_interactive = sys.stdin.isatty()

    print(f"Shell:         {shell_name}")
    print(f"Path:          {exe_path}")
    print(f"Version:       {version or 'unknown'}")
    print(f"PID / PPID:    {ppid} / {shell_ppid if shell_ppid is not None else 'unknown'}")
    if is_login is None:
        print("Login shell:   n/a (Windows)")
    else:
        print(f"Login shell:   {'yes' if is_login else 'no'}")
    print(f"Interactive:   {'unknown' if is_interactive is None else ('yes' if is_interactive else 'no')}")

    if config_files:
        cfg_str = ", ".join(f"{path} ({'found' if found else 'not found'})" for path, found in config_files)
    else:
        cfg_str = "none known for this shell"
    print(f"Config files:  {cfg_str}")

    print()
    if IS_WINDOWS:
        comspec = os.environ.get("COMSPEC")
        if comspec:
            if os.path.realpath(comspec) == os.path.realpath(exe_path):
                print(f"System default command processor (COMSPEC): {comspec} (matches running shell)")
            else:
                print(f"System default command processor (COMSPEC): {comspec} (differs from running shell)")
        else:
            print("System default command processor: unknown (COMSPEC not set)")
    else:
        default_shell = os.environ.get("SHELL")
        try:
            passwd_shell = pwd.getpwuid(os.getuid()).pw_shell
        except KeyError:
            passwd_shell = None

        if default_shell:
            if os.path.realpath(default_shell) == os.path.realpath(exe_path):
                print(f"Default login shell ($SHELL): {default_shell} (matches running shell)")
            else:
                print(f"Default login shell ($SHELL): {default_shell} (differs from running shell)")
        elif passwd_shell:
            print(f"Default login shell (/etc/passwd): {passwd_shell}")
        else:
            print("Default login shell: unknown ($SHELL not set)")


if __name__ == "__main__":
    main()
